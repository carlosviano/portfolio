---
import { site } from "../config/site";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { user, domain } = site.email;
---

<!--
  The full address never appears in the HTML source. The source has plain
  "user [at] domain" text; the script swaps it for a real mailto link.
-->
<span
  data-email-user={user}
  data-email-domain={domain}
  data-email-class={className}
>
  {user} [at] {domain}
</span>

<script>
  for (const placeholder of document.querySelectorAll<HTMLElement>(
    "[data-email-user]",
  )) {
    const { emailUser, emailDomain, emailClass } = placeholder.dataset;
    const address = `${emailUser}@${emailDomain}`;
    const link = document.createElement("a");
    link.href = `mailto:${address}`;
    link.textContent = address;
    if (emailClass) link.className = emailClass;
    placeholder.replaceWith(link);
  }
</script>
